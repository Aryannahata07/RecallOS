{
  "manifest_version": 3,
  "name": "RecallOS Catcher",
  "version": "1.0.0",
  "description": "Capture LeetCode, Articles, and Chat concepts into your RecallOS spaced-repetition engine.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "*://leetcode.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://*.medium.com/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "popup/logo-creme.png"
  },
  "icons": {
    "128": "popup/logo-creme.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/logo-creme.png", "popup/logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
